+
+// [CE] ---------------------------------------------------------------- corrector
+
+static bool hunspellKnows (const std::string& word, void* ctx)
+{
+    Hunhandle* h = static_cast<Hunhandle*>(ctx);
+    return h && Hunspell_spell(h, word.c_str()) != 0;
+}
+
+bool SmkyHunspellDatabase::hasCorrector (void) const
+{
+    return mp_corrector != NULL;
+}
+
+SmartKeyErrorCode SmkyHunspellDatabase::correct (const std::string& word, SpellCheckWordInfo& result, int maxGuesses)
+{
+    if (!mp_corrector)
+        return SKERR_FAILURE;
+    Sk::Correction c = mp_corrector->correct(word, maxGuesses, hunspellKnows, mp_dict_base);
+    result.inDictionary = c.valid;
+    for (size_t i = 0; i < c.guesses.size(); ++i)
+    {
+        WordGuess g(c.guesses[i].word);
+        g.spellCorrection = true;
+        if (i == 0 && c.autoAccept)
+        {
+            g.autoAccept = true;
+            g.autoReplace = c.caseOnly;   // i -> I, im -> I'm: a replacement, not a guess
+        }
+        result.guesses.push_back(g);
+    }
+    return SKERR_SUCCESS;
+}
