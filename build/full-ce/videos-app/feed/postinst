#!/bin/sh
# org.webosarchive.videos — post-flash install of the CE video player on a
# running device (3.0.5 or CE 3.1.0). Everything a baked image does for it
# (bake.py "Videos" tier) is replayed here, in a form that can be undone:
#   1. Photos album grid -> Videos app (patch on cryptofs, stock backed up)
#   2. com.palm.app.videoplayer becomes the Enyo player itself (rootfs)
#   3. Tweaks definition ("Pause video when minimized") + rescan
#   4. Videos app registered as the active handler for video types
# Every stage logs and continues; the exit status is always 0 (mmipkg/Preware
# treat a non-zero postinst as a failed install and leave a half-state behind).
# The RestartLuna flag in the control file makes Preware offer the Luna restart
# that Photos needs to pick up the patched source.

ROOT=${IPKG_OFFLINE_ROOT:-/media/cryptofs/apps}
APP=$ROOT/usr/palm/applications/org.webosarchive.videos
PAY=$APP/ce-install
LOG=/var/log/org.webosarchive.videos-install.log
log() { echo "$(date 2>/dev/null) $*" >> $LOG 2>/dev/null; echo "videos: $*"; }
md5() { md5sum < "$1" 2>/dev/null | cut -c1-32; }

# ---- 1. Photos (cryptofs, writable) -----------------------------------------
PH=/media/cryptofs/apps/usr/palm/applications/com.palm.app.photos/source/AlbumGridView.js
if [ -f "$PH" ]; then
    if grep -q 'org.webosarchive.videos' "$PH"; then
        log "Photos: already patched"
    elif [ "$(md5 "$PH")" != "@PHOTOS_STOCK_MD5@" ]; then
        log "Photos: AlbumGridView.js is not the stock file ($(md5 "$PH")); left alone -- Photos keeps its own player"
    else
        [ -f "$PH.webosce-orig" ] || cp -p "$PH" "$PH.webosce-orig"
        cp "$PH" "$PH.new"
        # busybox patch: -p N / -i DIFF only (no -s, no --fuzz); the result must be
        # byte-identical to what the build produced from the same stock file
        if (cd "$(dirname "$PH")" && patch -p2 -i "$PAY/AlbumGridView-videos-handoff.js.patch" "$(basename "$PH").new" >/dev/null 2>&1) \
           && [ "$(md5 "$PH.new")" = "@PHOTOS_PATCHED_MD5@" ]; then
            mv -f "$PH.new" "$PH"
            log "Photos: album grid now hands videos to the Videos app"
        else
            log "Photos: patch did not apply ($(md5 "$PH.new")); left alone"
            rm -f "$PH.new" "$PH.new.orig" "$PH.new.rej"
        fi
    fi
else
    log "Photos: not installed on cryptofs; skipped"
fi

# ---- 2. com.palm.app.videoplayer becomes the Enyo player (rootfs) ------------------
# Apps that launch the stock id (MeTube, Messaging) make LunaSysMgr pre-create a
# card for it; a forwarding shim left that card blank for ~2 s. Putting the player
# itself under the id means that card IS the player. Only index.html and
# appinfo.json are replaced (backed up); our source/css/depends.js and four
# images are added beside the untouched Mojo files and removed on uninstall.
VPD=/usr/palm/applications/com.palm.app.videoplayer
if [ -d "$VPD" ]; then
    if [ "$(md5 "$VPD/index.html")" = "$(md5 "$APP/index.html")" ] && [ "$(md5 "$VPD/source/VideoEngine.js")" = "$(md5 "$APP/source/VideoEngine.js")" ]; then
        log "videoplayer: already the CE player"
    elif [ "$(md5 "$VPD/index.html")" != "@VP_INDEX_STOCK_MD5@" ] && [ ! -f "$VPD/index.html.webosce-orig" ]; then
        log "videoplayer: index.html is not the stock file ($(md5 "$VPD/index.html")); left alone"
    elif [ "$(df -k / | tail -1 | awk '{print $(NF-2)}')" -lt 2048 ] 2>/dev/null; then   # busybox df wraps long device names
        log "videoplayer: less than 2 MB free on /; left alone"
    else
        L=/tmp/.ce-rootfs-rw.lock
        n=0; while ! mkdir $L 2>/dev/null && [ $n -lt 60 ]; do sleep 1; n=$((n+1)); done
        if mount -o remount,rw / 2>/dev/null; then
            for f in index.html appinfo.json; do
                [ -f "$VPD/$f.webosce-orig" ] || cp -p "$VPD/$f" "$VPD/$f.webosce-orig"
            done
            # an earlier build of this package installed a forwarding shim here
            if [ -f "$VPD/app/controllers/app-assistant.js.webosce-orig" ]; then
                mv -f "$VPD/app/controllers/app-assistant.js.webosce-orig" "$VPD/app/controllers/app-assistant.js"
            fi
            rm -rf "$VPD/source" "$VPD/css"
            cp -r "$APP/source" "$APP/css" "$VPD/" && cp "$APP/depends.js" "$VPD/depends.js" \
                && for i in menu-icons.png command-menu-gradient.png command-menu-gradient-top.png palm-menu-button.png; do cp "$APP/images/$i" "$VPD/images/$i"; done \
                && cp "$APP/index.html" "$VPD/index.html.new" && mv -f "$VPD/index.html.new" "$VPD/index.html" \
                && cp "$PAY/videoplayer-appinfo.json" "$VPD/appinfo.json.new" && mv -f "$VPD/appinfo.json.new" "$VPD/appinfo.json" \
                && chmod -R a+rX "$VPD/source" "$VPD/css" && chmod 644 "$VPD/depends.js" "$VPD/index.html" "$VPD/appinfo.json" \
                && log "videoplayer: com.palm.app.videoplayer is now the CE player" \
                || log "videoplayer: copy failed"
            mount -o remount,ro / 2>/dev/null || true
        else
            log "videoplayer: could not remount / rw; skipped (launches by id keep the stock player)"
        fi
        rmdir $L 2>/dev/null || true
    fi
fi

# ---- 3. Tweaks definition -------------------------------------------------------
TW=/media/cryptofs/apps/usr/palm/services/org.webosinternals.tweaks.prefs/preferences
mkdir -p "$TW" 2>/dev/null
if cp "$PAY/org.webosarchive.videos.json" "$TW/org.webosarchive.videos.json" 2>/dev/null; then
    log "tweaks: definition installed"
    [ -d /media/cryptofs/apps/usr/palm/services/org.webosinternals.tweaks.prefs/assistants ] \
        && luna-send -n 1 palm://org.webosinternals.tweaks.prefs/scan '{}' </dev/null >/dev/null 2>&1
fi

# ---- 4. resource handlers (persist in /var/usr/palm/command-resource-handlers-active.json)
AM=palm://com.palm.applicationManager
VAPP=org.webosarchive.videos
mime_for_ext() {
    luna-send -n 1 $AM/mimeTypeForExtension "{\"extension\":\"$1\"}" </dev/null 2>/dev/null \
        | sed -n 's/.*"mimeType": *"\([^"]*\)".*/\1/p' | sed 's#\\/#/#g'
}
register() {
    [ -n "$2" ] || return 0
    luna-send -n 1 $AM/addResourceHandler \
        "{\"extension\":\"$1\",\"mimeType\":\"$2\",\"appId\":\"$VAPP\"}" </dev/null >/dev/null 2>&1
    R=$(luna-send -n 1 $AM/listAllHandlersForMime "{\"mime\":\"$2\"}" </dev/null 2>&1)
    A=$(echo "$R" | sed -n 's/.*"activeHandler": *{\([^}]*\)}.*/\1/p')
    case "$A" in *$VAPP*) return 0 ;; esac
    IDX=$(echo "$R" | tr '}' '\n' | grep "$VAPP" | grep -o '"index": *[0-9]*' | grep -o '[0-9]*' | head -1)
    [ -n "$IDX" ] && luna-send -n 1 $AM/swapResourceHandler \
        "{\"mimeType\":\"$2\",\"index\":$IDX}" </dev/null >/dev/null 2>&1
}
for pair in "mp4 video/mp4" "m4v video/x-m4v" "3gp video/3gpp" "3g2 video/3gpp2" \
            "mov video/quicktime" "webm video/webm" "mkv video/x-matroska"; do
    set -- $pair
    register $1 $2
    register $1 "$(mime_for_ext $1)"
done
touch /media/internal/downloads/.ce-probe.mp4 2>/dev/null
R=$(luna-send -n 1 $AM/getResourceInfo '{"uri":"file:///media/internal/downloads/.ce-probe.mp4"}' </dev/null 2>&1)
rm -f /media/internal/downloads/.ce-probe.mp4 2>/dev/null
case "$R" in
    *$VAPP*) log "handlers: video files and URLs open in the Videos app" ;;
    *)       log "handlers: registration did not take: $R" ;;
esac

exit 0
